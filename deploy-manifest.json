{
  "version": 1,
  "framework": { "name": "express", "version": "5.1.0" },
  "routes": [
    { "path": "/*.*", "target": { "kind": "Static" } },
    { "path": "/*",   "target": { "kind": "Compute", "src": "default" } }
  ],
  "computeResources": [
    {
      "name": "default",
      "runtime": "nodejs18.x",
      "entrypoint": "server.js"
    }
  ]
}
