{
  "version": 1,
  "framework": { "name": "express", "version": "5.1.0" },
  "routes": [
    {
      "path": "/api/*",
      "target": { "kind": "Compute", "src": "default" }
    },
    {
      "path": "/*.*",
      "target": { "kind": "Static" }
    },
    {
      "path": "/*",
      "target": { "kind": "Static" }
    }
  ],
  "computeResources": [
    {
      "name": "default",
      "runtime": "nodejs18.x",
      "entrypoint": "server.js"
    }
  ]
}
